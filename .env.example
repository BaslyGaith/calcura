# Base de données (SQLite par défaut ; mettez une URL PostgreSQL en production
# et changez `provider` dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Secret de signature des sessions (32+ caractères aléatoires)
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
# Compte administrateur créé par le seed
ADMIN_EMAIL="admin@bonplan.tn"
ADMIN_PASSWORD="Admin123!"
# Style de carte (facultatif). Par défaut : OpenFreeMap « liberty » (gratuit, sans clé).
# Exemples : https://tiles.openfreemap.org/styles/bright ou un style MapTiler/Stadia avec votre clé.
# NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
# Secret pour l'appel quotidien /api/cron/subscriptions
# CRON_SECRET="changez-moi"
